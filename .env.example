# Copy this file to `.env.local` (git-ignored) and fill in what you need.

# --- Contact form delivery -------------------------------------------------
# Set ONE of the following so form submissions are emailed to you directly.
# With neither set, the form falls back to opening the visitor's mail client.
#
# Web3Forms (https://web3forms.com) — free, no account needed. Enter your email
# on their site and they send you an access key. Safe to expose client-side.
VITE_WEB3FORMS_KEY=
# Formspree (https://formspree.io) — free tier covers 50 submissions/month.
# Create a form and copy the id from the endpoint URL (formspree.io/f/<id>).
VITE_FORMSPREE_ID=

# --- Dev server ------------------------------------------------------------
# Set to true only when you need the Vite dev server reachable from other
# devices on your network or through a tunnel. Leave unset for normal local
# development (binds to 127.0.0.1).
VITE_EXPOSE_DEV_SERVER=false
